# Creative Editor — environment configuration
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is gitignored and must NEVER be committed.
# The Groq key is read by the SERVER ONLY (server.js) and is never sent to the
# browser; the client talks to our own /api/generate endpoint instead.

# --- Required ---------------------------------------------------------------

# Groq API key. Get one at https://console.groq.com/keys
# Without this the server still starts and serves the editor, but /api/generate
# returns an error ("GROQ_API_KEY missing from .env").
GROQ_API_KEY=

# --- Optional ---------------------------------------------------------------

# HTTP port for the local server.
# PORT=8470

# Model used for text-only prompts.
# TEXT_MODEL=llama-3.3-70b-versatile

# Model used when a reference image is attached (must be vision-capable).
# VISION_MODEL=qwen/qwen3.6-27b

# Chat-completions endpoint. Overridable so automated tests can point the
# server at a local mock instead of the real provider. Leave unset in normal
# use; tests set it themselves.
# GROQ_URL=https://api.groq.com/openai/v1/chat/completions
